# === Production Environment ===
# Copy this file to .env and fill in your real values

# Database (PostgreSQL on VPS port 5432)
DATABASE_URL=postgresql://leadkid_user:YOUR_DB_PASSWORD@localhost:5432/leadkid_db

# NextAuth
NEXTAUTH_SECRET=YOUR_RANDOM_32_CHAR_SECRET_CHANGE_THIS
NEXTAUTH_URL=https://slm.io.vn

# Google Places API
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Gemini AI
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash-lite

# SePay Payment
SEPAY_WEBHOOK_SECRET=YOUR_SEPAY_WEBHOOK_SECRET
SEPAY_BANK_ACCOUNT=YOUR_BANK_ACCOUNT_NUMBER
SEPAY_BANK_CODE=YOUR_BANK_CODE
SEPAY_ACCOUNT_NAME=YOUR_ACCOUNT_NAME

# 2Captcha Proxy
CAPTCHA_API_KEY=YOUR_CAPTCHA_API_KEY

# MinIO (optional)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=leadkit-exports

# Redis (Docker service name 'redis')
REDIS_URL=redis://redis:6379

# App Config
APP_URL=https://slm.io.vn
MAX_CONCURRENT_JOBS=2
FREE_DAILY_LEAD_VIEWS=5
WORKER_POLL_INTERVAL_MS=5000
JOB_LEASE_MINUTES=10

# Gosom Scraper (Docker service name 'gosom')
GOSOM_API_URL=http://gosom:8080
GOSOM_RATE_LIMIT_MS=10000
GOSOM_POLL_INTERVAL_MS=5000
GOSOM_MAX_WAIT_MS=600000
GOSOM_DEPTH=1

# Google Search Console verification (optional)
# GOOGLE_SITE_VERIFICATION=YOUR_VERIFICATION_CODE
